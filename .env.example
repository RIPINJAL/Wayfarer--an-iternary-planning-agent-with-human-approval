# Use "ollama" for local model planning or "india" for the no-model, map-based India planner.
AI_PROVIDER=anthropic

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Used when AI_PROVIDER=ollama (install Ollama and pull this model first).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Optional
# Max output tokens for one planning turn (long trips need more)
MAX_OUTPUT_TOKENS=24000
# Let the agent search the web for current info (Anthropic provider only; requires web search enabled on your org)
ENABLE_WEB_SEARCH=true
# Where the SQLite file lives. In Docker this is mounted as a volume.
DATABASE_PATH=./data/wayfarer.db
# Cost protection: planning runs per visitor per hour, and across the whole app per day
RATE_LIMIT_PER_HOUR=8
DAILY_PLAN_CAP=300
# Contact used in User-Agent for free geocoding services (their usage policies ask for this)
CONTACT_EMAIL=you@example.com
